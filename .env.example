POSTGRES_DB=themis
POSTGRES_USER=themis
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Private object storage placeholders. Leave blank until backend integration.
STORAGE_PROVIDER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=

# AI provider placeholders. Keep secrets in an uncommitted local .env only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Embedding model and its real provider dimension must be configured together.
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
